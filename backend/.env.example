# Copy this file to .env and fill in your remote Zabbix DB details.
DB_HOST=your-zabbix-db-host.example.com
DB_PORT=3306
DB_USER=zbx_reporter
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=zabbix

# Connection pool size (default 5)
DB_POOL_SIZE=5

# Safety cap: max raw (non-aggregated) rows returned per item in one report.
MAX_RAW_POINTS=20000

# Timezone offset in minutes east of UTC for date pickers, HOURS filter, and chart labels.
# Examples: 180 = UTC+3 (EAT), 0 = UTC, -300 = UTC-5 (US Eastern)
# If left at 0, the frontend falls back to the browser's local timezone.
TZ_OFFSET_MINUTES=180

# ── Zabbix user login / rights integration ──────────────────────────────────
# Every user logs in with their real Zabbix username/password. Auth and
# host-group/host visibility are both delegated to the Zabbix frontend/
# server's own JSON-RPC API — NOT the DB connection above, which stays
# read-only and is only ever used for report/dashboard/problem data.
# Point this at your Zabbix frontend's api_jsonrpc.php; it must be
# reachable from wherever this app runs.
ZABBIX_API_URL=http://your-zabbix-server/api_jsonrpc.php

# Request timeout for calls to the Zabbix API (seconds).
ZABBIX_API_TIMEOUT_SECONDS=10

# Verify the Zabbix API's TLS certificate. Only disable for trusted
# internal networks with self-signed certs you can't otherwise install.
ZABBIX_API_VERIFY_TLS=true

# Server-side idle timeout for a logged-in session, in minutes. The
# session is force-expired after this many minutes without a request,
# regardless of how long the browser cookie itself is kept around.
SESSION_IDLE_TTL_MINUTES=480

# How long the browser holds on to the session cookie (the server-side
# idle timeout above is the real enforcement point).
SESSION_COOKIE_MAX_AGE_DAYS=30

SESSION_COOKIE_NAME=zr_session

# How long a user's permitted host-group/host lists are cached locally
# before being re-fetched from the Zabbix API. Lower = permission
# changes in Zabbix take effect faster here; higher = fewer API calls.
PERMISSION_CACHE_TTL_SECONDS=300

# Set to false only for local HTTP development. Keep true whenever this
# app is served over HTTPS so the session cookie gets the Secure flag —
# browsers silently drop Secure cookies over plain HTTP.
COOKIE_SECURE=true
